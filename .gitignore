# Test output
*.log
test_output/

# Fuzzer corpus and crash artefacts (regenerable; libFuzzer discovers more on each run)
test/corpus/
crash-*
leak-*
oom-*
timeout-*

# Benchmark datasets (multi-GB, fetched via datasets/fetch_sift.sh) and vendored deps
datasets/sift/
datasets/gist/
datasets/*.tar.gz
datasets/gt/
third_party/


